{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "diagnostics": {
    "disable": ["need-check-nil", "annotation-usage-error"],
    "enables": [],
    "globals": [],
    "globalsRegex": []
  },
  "runtime": {
    "requirePattern": [
      "lua/?/init.lua",
      "lua/?.lua",
      "?/lua/?/init.lua",
      "?/lua/?.lua",
      "?.lua",
      "?/init.lua"
    ],
    "version": "LuaJIT"
  },
  "workspace": {
    "ignoreGlobs": ["**/*_spec.lua"],
    "library": [
      "$VIMRUNTIME",
      "$HOME/.local/share/nvim/site/pack/core/opt/emmylua-nvim/nvim/library",
      "$HOME/.local/share/nvim/site/pack/core/opt/snacks.nvim"
    ]
  }
}
