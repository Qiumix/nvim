{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "requirePattern": [
      "lua/?/init.lua",
      "lua/?.lua",
      "?/lua/?/init.lua",
      "?/lua/?.lua"
    ]
  },
  "diagnostics": {
    "disable": ["unresolved-require", "undefined-field"],
    "enables": [],
    "globals": [],
    "globalsRegex": []
  },
  "workspace": {
    "library": [
      "$VIMRUNTIME",
      "$HOME/.local/share/nvim/site/pack/core/opt/zpack.nvim",
      "$HOME/.local/share/nvim/site/pack/core/opt/snacks.nvim"
    ],
    "ignoreGlobs": ["**/*_spec.lua"]
  }
}
